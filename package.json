{
  "name": "rematecr-ai",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=24" },
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w @rematecr/backend\" \"npm run dev -w @rematecr/frontend\"",
    "build": "npm run build -w @rematecr/frontend",
    "preflight:production": "npm run preflight:production -w @rematecr/backend",
    "start": "npm run start -w @rematecr/backend",
    "test": "npm run test -w @rematecr/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
